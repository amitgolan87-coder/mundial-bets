rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // === USERS ===
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      allow update: if (isOwner(uid) &&
                       request.resource.data.isAdmin == resource.data.isAdmin &&
                       request.resource.data.matchPoints == resource.data.matchPoints &&
                       request.resource.data.livePoints == resource.data.livePoints &&
                       request.resource.data.duelPoints == resource.data.duelPoints)
                    || isAdmin();
      allow delete: if isAdmin();

      // === USER'S MATCH BETS ===
      match /bets/{matchId} {
        allow create, update: if isOwner(uid);
        allow delete: if isAdmin();
        allow read: if isOwner(uid) || isAdmin() || (
          isSignedIn() &&
          exists(/databases/$(database)/documents/matches/$(matchId)) &&
          (
            get(/databases/$(database)/documents/matches/$(matchId)).data.status == 'finished' ||
            get(/databases/$(database)/documents/matches/$(matchId)).data.kickoffAt < request.time + duration.value(24, 'h')
          )
        );
      }

      // === USER'S LIVE BET ENTRIES ===
      match /liveEntries/{liveBetId} {
        allow create, update: if isOwner(uid);
        allow delete: if isAdmin();
        allow read: if isOwner(uid) || isAdmin() || (
          isSignedIn() &&
          exists(/databases/$(database)/documents/liveBets/$(liveBetId)) &&
          (
            get(/databases/$(database)/documents/liveBets/$(liveBetId)).data.settled == true ||
            get(/databases/$(database)/documents/liveBets/$(liveBetId)).data.closesAt < request.time
          )
        );
      }
    }

    // === COLLECTION GROUP QUERIES (for Transparency page) ===
    // Allow signed-in users to query bets/liveEntries across all users,
    // BUT only return docs where the related match/liveBet is already locked.
    // This prevents the transparency page from leaking open predictions.
    match /{path=**}/bets/{matchId} {
      allow read: if isSignedIn() &&
        exists(/databases/$(database)/documents/matches/$(matchId)) &&
        (
          get(/databases/$(database)/documents/matches/$(matchId)).data.status == 'finished' ||
          get(/databases/$(database)/documents/matches/$(matchId)).data.kickoffAt < request.time + duration.value(24, 'h')
        );
    }

    match /{path=**}/liveEntries/{liveBetId} {
      allow read: if isSignedIn() &&
        exists(/databases/$(database)/documents/liveBets/$(liveBetId)) &&
        (
          get(/databases/$(database)/documents/liveBets/$(liveBetId)).data.settled == true ||
          get(/databases/$(database)/documents/liveBets/$(liveBetId)).data.closesAt < request.time
        );
    }

    // === MATCHES ===
    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // === LIVE BETS ===
    match /liveBets/{liveBetId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // === DUELS ===
    match /duels/{duelId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.challengerId == request.auth.uid;
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.status == 'open' &&
        resource.data.challengerId != request.auth.uid &&
        request.resource.data.opponentId == request.auth.uid &&
        request.resource.data.status == 'accepted'
      );
      allow delete: if isAdmin();
    }
  }
}
