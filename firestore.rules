rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============ HELPER FUNCTIONS ============
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Returns true if the requesting user is APPROVED (status == 'approved').
    // Existing legacy users without a status field default to approved.
    function isApproved() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          !('status' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'
        );
    }

    // Admin OR approved player
    function isActive() {
      return isAdmin() || isApproved();
    }

    // ============ USERS ============
    match /users/{uid} {
      // Read:
      //   - any signed-in user can read their OWN profile (needed to learn their status).
      //   - admins can read any user.
      //   - APPROVED users can read other approved users (for leaderboards).
      //   - pending/disabled users CANNOT see other users.
      allow read: if isOwner(uid) || isAdmin() || (
        isApproved() &&
        (
          !('status' in resource.data) ||
          resource.data.status == 'approved'
        )
      );

      allow create: if isOwner(uid);

      // Update:
      //   - the user themselves can update non-sensitive fields,
      //     but cannot change isAdmin, status, or any points.
      //   - admins can update anything.
      allow update: if (
        isOwner(uid) &&
        request.resource.data.isAdmin == resource.data.isAdmin &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.matchPoints == resource.data.matchPoints &&
        request.resource.data.livePoints == resource.data.livePoints &&
        request.resource.data.duelPoints == resource.data.duelPoints
      ) || isAdmin();

      allow delete: if isAdmin();

      // ============ USER'S MATCH BETS ============
      match /bets/{matchId} {
        allow create, update: if isOwner(uid) && isApproved();
        allow delete: if isAdmin();
        allow read: if isOwner(uid) || isAdmin() || (
          isApproved() &&
          exists(/databases/$(database)/documents/matches/$(matchId)) &&
          (
            get(/databases/$(database)/documents/matches/$(matchId)).data.status == 'finished' ||
            get(/databases/$(database)/documents/matches/$(matchId)).data.kickoffAt < request.time + duration.value(24, 'h')
          )
        );
      }

      // ============ USER'S LIVE BET ENTRIES ============
      match /liveEntries/{liveBetId} {
        allow create, update: if isOwner(uid) && isApproved();
        allow delete: if isAdmin();
        allow read: if isOwner(uid) || isAdmin() || (
          isApproved() &&
          exists(/databases/$(database)/documents/liveBets/$(liveBetId)) &&
          (
            get(/databases/$(database)/documents/liveBets/$(liveBetId)).data.settled == true ||
            get(/databases/$(database)/documents/liveBets/$(liveBetId)).data.closesAt < request.time
          )
        );
      }

      // ============ USER'S ADJUSTMENT LOG ============
      match /adjustments/{adjustmentId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isAdmin();
        allow update, delete: if false;
      }
    }

    // ============ COLLECTION GROUP QUERIES (Transparency) ============
    match /{path=**}/bets/{matchId} {
      allow read: if isApproved() &&
        exists(/databases/$(database)/documents/matches/$(matchId)) &&
        (
          get(/databases/$(database)/documents/matches/$(matchId)).data.status == 'finished' ||
          get(/databases/$(database)/documents/matches/$(matchId)).data.kickoffAt < request.time + duration.value(24, 'h')
        );
    }

    match /{path=**}/liveEntries/{liveBetId} {
      allow read: if isApproved() &&
        exists(/databases/$(database)/documents/liveBets/$(liveBetId)) &&
        (
          get(/databases/$(database)/documents/liveBets/$(liveBetId)).data.settled == true ||
          get(/databases/$(database)/documents/liveBets/$(liveBetId)).data.closesAt < request.time
        );
    }

    // ============ MATCHES ============
    match /matches/{matchId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // ============ LIVE BETS ============
    match /liveBets/{liveBetId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // ============ DUELS ============
    match /duels/{duelId} {
      allow read: if isActive();
      allow create: if isApproved() && request.resource.data.challengerId == request.auth.uid;
      allow update: if isAdmin() || (
        isApproved() &&
        resource.data.status == 'open' &&
        resource.data.challengerId != request.auth.uid &&
        request.resource.data.opponentId == request.auth.uid &&
        request.resource.data.status == 'accepted'
      );
      allow delete: if isAdmin() || (
        isApproved() &&
        resource.data.status == 'open' &&
        resource.data.challengerId == request.auth.uid
      ) || (
        isApproved() &&
        resource.data.status == 'accepted' &&
        (resource.data.challengerId == request.auth.uid || resource.data.opponentId == request.auth.uid)
      );
    }
  }
}
